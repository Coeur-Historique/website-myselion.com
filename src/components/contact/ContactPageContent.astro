---
// src/components/contact/ContactPageContent.astro — page de contact standardisée du shell
// (module shell-contact). Code identique sur tous les sites : seuls le nom et les coordonnées
// (site.variables.ts : contactData, openingHours, mapQuery) changent.
import { StandardContactPage } from '@coeur-historique/website-shell/contact';
import { type Locale } from '../../i18n';
import { SITE_VARIABLES } from '../../site.variables';
import translations from '../../i18n/translations.json';

interface Props {
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
---

<StandardContactPage siteConfig={SITE_VARIABLES} translations={translations} lang={lang} />
