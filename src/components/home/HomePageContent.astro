---
// src/components/home/HomePageContent.astro — accueil mySelion, repris de l'ancien
// www.myselion.com (Odoo) le 27/10/2026 : accroche, modules, « Simplifiez la gestion »,
// offres, atouts, contenus à la une, derniers articles, chiffres et partenaires.
// Textes : src/i18n/contenu/fr.json ; images : src/assets/accueil et src/assets/partenaires.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { SITE_VARIABLES } from '../../site.variables';
import { getBlogEntryLocale, type Locale } from '../../i18n';
import { contenu } from '../../i18n/contenu';
import apercu from '../../assets/accueil/apercu.png';
import spread from '../../assets/accueil/spread.webp';
import readySetGo from '../../assets/accueil/ready-set-go.webp';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const L = contenu(lang);
const lien = (chemin: string) => `/${lang}${chemin}`;
const agenda = SITE_VARIABLES.socialLinks?.googleAgenda?.url ?? lien('/contact/');
const rappel = SITE_VARIABLES.contactData.ringMeUrl ?? lien('/contact/');
const visuels: Record<string, ImageMetadata> = { 'programme-partenaire-spread': spread, 'ready-set-go-1-hour-setup': readySetGo };

const partenaires = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/partenaires/*.{png,webp}', { eager: true }),
).map((m) => m.default);

const derniers = (await getCollection('blog', (a) => getBlogEntryLocale(a.id) === lang))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const date = (d: Date) => d.toLocaleDateString(`${lang}-BE`, { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="hero">
  <div class="container py-5 text-center">
    <h1>{L.hero.titre}</h1>
    <p class="sous-titre">{L.hero.sousTitre}</p>
    <p class="badge-hero"><Icon name="fa6-solid:bolt" aria-hidden="true" /> {L.hero.badge}</p>
    <div class="d-flex flex-wrap gap-2 justify-content-center">
      <a class="btn-mys" href={agenda} target="_blank" rel="noopener noreferrer">{L.hero.cta}</a>
      <a class="btn-mys btn-mys-contour" href="#offres">{L.hero.ctaSecondaire}</a>
    </div>
  </div>
</section>

<section class="py-5 ancre" id="modules">
  <div class="container">
    <h2 class="titre-section text-center">{L.modules.titre}</h2>
    <p class="intro text-center">{L.modules.intro}</p>
    <div class="row g-3">
      {L.modules.familles.map((f) => (
        <div class="col-md-6 col-lg-4">
          <article class="famille">
            <h3>{f.nom}</h3>
            <ul>
              {f.modules.map(([nom, icone]) => (
                <li>
                  <Icon name={icone} aria-hidden="true" />
                  {nom}
                  {nom === 'myS in App' && <span class="beta">{L.modules.beta}</span>}
                </li>
              ))}
            </ul>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-5 bande ancre" id="plateforme">
  <div class="container">
    <div class="row g-4 align-items-center">
      <div class="col-lg-6">
        <h2 class="titre-section">{L.simplifier.titre}</h2>
        <p>{L.simplifier.texte}</p>
        <ul class="coches">{L.simplifier.points.map((p) => <li><Icon name="fa6-solid:check" aria-hidden="true" /> {p}</li>)}</ul>
        <a class="btn-mys" href={agenda} target="_blank" rel="noopener noreferrer">{L.simplifier.cta}</a>
      </div>
      <div class="col-lg-6">
        <Image src={apercu} alt="Aperçu de la plateforme mySelion" widths={[640, 960, 1280]} sizes="(min-width: 992px) 50vw, 100vw" class="apercu" />
      </div>
    </div>
  </div>
</section>

<section class="py-5 ancre" id="offres">
  <div class="container">
    <h2 class="titre-section text-center">{L.offres.titre}</h2>
    <p class="intro text-center">{L.offres.intro}</p>
    <div class="row g-4">
      {L.offres.plans.map((plan) => (
        <div class="col-lg-4">
          <article class:list={['offre', { vedette: 'vedette' in plan && plan.vedette }]}>
            <h3>{plan.nom}</h3>
            <p class="prix"><strong>{plan.prix}</strong> <span>{L.offres.periode}</span></p>
            <p class="texte">{plan.texte}</p>
            <a class="btn-mys" href={plan.lien === 'rappel' ? rappel : agenda} target="_blank" rel="noopener noreferrer">{plan.cta}</a>
            <ul class="coches">{plan.inclus.map((i) => <li><Icon name="fa6-solid:check" aria-hidden="true" /> {i}</li>)}</ul>
            <p class="note">{L.offres.note}</p>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-5 bande-fonce ancre" id="atouts">
  <div class="container">
    <h2 class="titre-section text-center">{L.atouts.titre}</h2>
    <p class="intro text-center">{L.atouts.intro}</p>
    <div class="row g-4">
      {L.atouts.liste.map(([titre, texte, icone]) => (
        <div class="col-md-6 col-lg-4">
          <article class="atout">
            <Icon name={icone} aria-hidden="true" />
            <h3>{titre}</h3>
            <p>{texte}</p>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <h2 class="titre-section">{L.aLaUne.titre}</h2>
    <div class="row g-4">
      {L.aLaUne.cartes.map((c) => (
        <div class="col-lg-4">
          <article class="une">
            {c.image && visuels[c.image] && <Image src={visuels[c.image]} alt="" width={640} class="une-img" />}
            <div class="une-corps">
              <h3>{c.titre}</h3>
              <p>{c.texte}</p>
              {c.lien && <a class="lien" href={lien(c.lien)}>{c.cta} →</a>}
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-5 bg-white">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
      <div>
        <h2 class="titre-section mb-1">{L.derniers.titre}</h2>
        <p class="mb-0">{L.derniers.intro}</p>
      </div>
      <a class="lien" href={lien('/blog/')}>{L.derniers.tout} →</a>
    </div>
    <div class="row g-4">
      {derniers.map((a) => (
        <div class="col-md-4">
          <a class="une" href={lien(`/blog/${a.data.customSlug ?? a.id}/`)}>
            {a.data.image && <Image src={a.data.image} alt="" width={640} class="une-img" />}
            <div class="une-corps">
              <p class="meta">{a.data.category} · <time datetime={a.data.pubDate.toISOString()}>{date(a.data.pubDate)}</time></p>
              <h3>{a.data.title}</h3>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="chiffres">
  <div class="container">
    <ul>{L.chiffres.map(([valeur, libelle]) => <li><strong>{valeur}</strong><span>{libelle}</span></li>)}</ul>
  </div>
</section>

<section class="py-5 bg-white">
  <div class="container">
    <h2 class="titre-section text-center">{L.partenaires.titre}</h2>
    <ul class="partenaires">
      {partenaires.map((logo) => <li><Image src={logo} alt="" width={120} /></li>)}
    </ul>
  </div>
</section>

<style>
  .ancre {
    scroll-margin-top: 6rem;
  }
  .hero {
    background: linear-gradient(135deg, #2e4c77, #4877b9);
    color: #fff;
  }
  .hero h1 {
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.4rem);
    max-width: 48rem;
    margin: 1rem auto 0.5rem;
  }
  .sous-titre {
    font-size: 1.35rem;
    opacity: 0.9;
  }
  .badge-hero {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    font-weight: 700;
  }
  .btn-mys {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    background: #4877b9;
    color: #fff;
    border: 2px solid #4877b9;
  }
  .hero .btn-mys {
    background: #fff;
    color: #2e4c77;
    border-color: #fff;
  }
  .btn-mys-contour,
  .hero .btn-mys-contour {
    background: transparent;
    color: inherit;
  }
  .titre-section {
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    margin-bottom: 0.75rem;
  }
  .intro {
    max-width: 44rem;
    margin: 0 auto 2rem;
    color: #475569;
  }
  .famille,
  .offre,
  .une {
    height: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    background: #fff;
  }
  .famille {
    padding: 1.4rem;
  }
  .famille h3 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #2e4c77;
  }
  .famille ul,
  .coches {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .famille li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.3rem 0;
  }
  .famille li :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: #4877b9;
    flex: none;
  }
  .beta {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.05rem 0.4rem;
    border-radius: 0.3rem;
    background: #114b5f;
    color: #fff;
  }
  .bande {
    background: #f2f0f5;
  }
  .coches li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.25rem 0;
  }
  .coches li :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    color: #4877b9;
    flex: none;
  }
  .bande .coches {
    margin-bottom: 1.25rem;
  }
  :global(.apercu) {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 16px 40px rgba(46, 76, 119, 0.2);
  }
  .offre {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
  }
  .offre.vedette {
    border: 2px solid #4877b9;
    box-shadow: 0 16px 40px rgba(46, 76, 119, 0.15);
  }
  .offre h3 {
    font-weight: 800;
    color: #2e4c77;
  }
  .prix strong {
    font-size: 2.2rem;
    font-weight: 800;
  }
  .prix span,
  .note {
    color: #64748b;
    font-size: 0.9rem;
  }
  .offre .btn-mys {
    align-self: flex-start;
  }
  .note {
    margin: auto 0 0;
  }
  .bande-fonce {
    background: #2e4c77;
    color: #fff;
  }
  .bande-fonce .intro {
    color: rgba(255, 255, 255, 0.85);
  }
  .atout {
    text-align: center;
    padding: 1rem;
  }
  .atout :global(svg) {
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 0.75rem;
  }
  .atout h3 {
    font-size: 1.15rem;
    font-weight: 800;
  }
  .atout p {
    margin: 0;
    opacity: 0.9;
  }
  .une {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }
  :global(.une-img) {
    width: 100%;
    height: 12rem;
    object-fit: cover;
  }
  .une-corps {
    padding: 1.2rem 1.3rem 1.4rem;
  }
  .une h3 {
    font-size: 1.15rem;
    font-weight: 800;
  }
  .meta {
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 0.4rem;
  }
  .lien {
    font-weight: 700;
    text-decoration: none;
  }
  .chiffres {
    background: linear-gradient(135deg, #114b5f, #2e4c77);
    color: #fff;
    padding: 4rem 0;
  }
  .chiffres ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    text-align: center;
  }
  .chiffres strong {
    display: block;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
  }
  @media (min-width: 768px) {
    .chiffres ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .partenaires {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
  }
  .partenaires :global(img) {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
</style>
